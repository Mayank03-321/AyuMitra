# GEMINI_API_KEY: Required for Gemini AI clinical summarization and intake extraction.
# Obtain your key from https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# PORT: Server port (defaults to 3000)
PORT=3000

# APP_URL: Optional application base URL for OAuth callbacks and API endpoints
APP_URL="http://localhost:3000"
